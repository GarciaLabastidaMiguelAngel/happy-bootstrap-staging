{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happy.local/schemas/knowledge-candidate.schema.json",
  "title": "Knowledge Candidate",
  "$comment": "AAI-SPEC-0007/0004 v0.1.0-draft / PREPARED_NOT_DELIVERED",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateId", "version", "state", "candidateType", "statement", "scope", "authority", "confidence", "evidenceRefs", "reconciliation", "createdAt"],
  "properties": {
    "candidateId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "state": {"type": "string", "enum": ["RECEIVED", "EXTRACTED", "CLASSIFIED", "RECONCILED", "PROPOSED", "IN_REVIEW", "APPROVED", "REJECTED", "DEFERRED"]},
    "candidateType": {"type": "string", "enum": ["FACT", "DECISION", "REQUIREMENT", "CONSTRAINT", "SPECIFICATION", "INTERFACE", "CONTRACT", "MODEL", "COMPONENT", "FLOW", "RULE", "PATTERN", "ADR", "RISK", "CONTROL", "REFERENCE"]},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"$ref": "common.schema.json#/$defs/Scope"},
    "authority": {"$ref": "common.schema.json#/$defs/AuthorityType"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/EvidenceRef"}},
    "reconciliation": {"type": "string", "enum": ["MATCH", "ENRICHMENT", "UPDATE", "CONFLICT", "DUPLICATE", "SUPERSEDES", "UNRELATED", "AMBIGUOUS"]},
    "comparedWith": {"type": "array", "items": {"type": "string"}},
    "ownerId": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "conflictIds": {"type": "array", "items": {"type": "string"}},
    "proposedCanonicalTarget": {"type": "string"}
  }
}
