{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happy.local/schemas/bootstrap-receipt.schema.json",
  "title": "BootstrapReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "seedVersion", "snapshotId", "seedHash", "integrityStatus", "bootstrapStart", "bootstrapEnd", "environmentIdentity", "hostRuntimeSummary", "implementationSourceStatus", "baselineReconciliationStatus", "buildRuntimeStatus", "canonicalSourcesLoaded", "openSERs", "openResearchObligations", "currentCapabilityState", "currentGates", "blockingConditions", "firstExecutableFrontier", "humanDecisionsRequired", "nextActions", "evidenceReferences"],
  "properties": {
    "receiptId": {"type": "string", "minLength": 1},
    "seedVersion": {"const": "1.0.0-rc1"},
    "snapshotId": {"const": "SEED-SNAPSHOT-CLOSE-001"},
    "seedHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "integrityStatus": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "bootstrapStart": {"type": "string", "format": "date-time"},
    "bootstrapEnd": {"type": "string", "format": "date-time"},
    "environmentIdentity": {"type": "string", "minLength": 1},
    "hostRuntimeSummary": {"type": "object", "description": "Redacted observation; never canonical platform identity", "additionalProperties": true},
    "repositoryIdentity": {"type": "string"},
    "branch": {"type": "string"},
    "commit": {"type": "string"},
    "workingTreeState": {"enum": ["CLEAN", "DIRTY", "UNKNOWN", "NOT_AVAILABLE"]},
    "javaRuntime": {"type": "string"},
    "implementationSourceStatus": {"enum": ["IDENTIFIED", "BLOCKED_BY_SOURCE", "INACCESSIBLE", "CONFLICTED"]},
    "baselineReconciliationStatus": {"enum": ["MATCH", "PARTIAL", "MISSING", "INACCESSIBLE", "CONFLICTED", "NOT_EXECUTED"]},
    "buildRuntimeStatus": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "NOT_EXECUTED"]},
    "implementationSourceReceipt": {"$ref": "implementation-source-receipt.schema.json"},
    "baselineReconciliationReceipt": {"$ref": "baseline-reconciliation-receipt.schema.json"},
    "buildRuntimeReceipt": {"$ref": "build-runtime-receipt.schema.json"},
    "canonicalSourcesLoaded": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "openSERs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "openResearchObligations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "currentCapabilityState": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "currentGates": {"type": "array", "items": {"type": "object", "required": ["gate", "state"], "properties": {"gate": {"type": "string"}, "state": {"type": "string"}}, "additionalProperties": true}},
    "blockingConditions": {"type": "array", "items": {"type": "string"}},
    "firstExecutableFrontier": {"type": "array", "items": {"type": "object", "required": ["work", "eligibility"], "properties": {"work": {"type": "string"}, "eligibility": {"enum": ["ELIGIBLE", "BLOCKED", "DEFERRED"]}}, "additionalProperties": true}},
    "humanDecisionsRequired": {"type": "array", "items": {"type": "string"}},
    "nextActions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidenceReferences": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  }
}
