{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happy.local/schemas/delegation-record.schema.json",
  "title": "Task Delegation Record",
  "$comment": "AAI-SPEC-0009 v0.1.0-draft / PREPARED_NOT_DELIVERED. Exact identity provider, permissions and persistence mapping are BLOCKED_BY_SOURCE(SER-002/SER-007).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delegationId",
    "taskId",
    "taskVersion",
    "from",
    "to",
    "delegatedBy",
    "reason",
    "validFrom",
    "status",
    "allowedActions",
    "createdAt",
    "correlationId",
    "sourceRefs"
  ],
  "properties": {
    "delegationId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "taskId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "taskVersion": {"type": "integer", "minimum": 1},
    "from": {"$ref": "#/$defs/SubjectRef"},
    "to": {"$ref": "#/$defs/SubjectRef"},
    "delegatedBy": {"$ref": "#/$defs/SubjectRef"},
    "reason": {"type": "string", "minLength": 1},
    "expertiseReason": {"type": "string"},
    "scope": {"$ref": "common.schema.json#/$defs/Scope"},
    "validFrom": {"$ref": "common.schema.json#/$defs/Timestamp"},
    "validUntil": {"$ref": "common.schema.json#/$defs/Timestamp"},
    "status": {"type": "string", "enum": ["ACTIVE", "REVOKED", "EXPIRED", "COMPLETED"]},
    "allowedActions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "excludedActions": {"type": "array", "items": {"type": "string"}},
    "approvalAuthorityTransferred": {"const": false},
    "riskAcceptanceAuthorityTransferred": {"const": false},
    "createdAt": {"$ref": "common.schema.json#/$defs/Timestamp"},
    "revokedAt": {"$ref": "common.schema.json#/$defs/Timestamp"},
    "correlationId": {"$ref": "common.schema.json#/$defs/Identifier"},
    "evidenceRefs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/EvidenceRef"}},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recordDigest": {"$ref": "common.schema.json#/$defs/Digest"}
  },
  "$defs": {
    "SubjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectType", "subjectId"],
      "properties": {
        "subjectType": {"type": "string", "enum": ["HUMAN", "AGENT", "WORKLOAD", "TEAM", "UNKNOWN"]},
        "subjectId": {"type": "string", "minLength": 1},
        "formalResponsibilityRef": {"type": "string"},
        "observedExpertiseRefs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
