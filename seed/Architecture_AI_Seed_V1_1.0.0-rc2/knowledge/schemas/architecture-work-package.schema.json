{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happy.local/schemas/architecture-work-package.schema.json",
  "title": "Architecture Work Package",
  "$comment": "AAI-SPEC-0005 v0.1.0-draft / PREPARED_NOT_DELIVERED",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "version", "taskId", "requestId", "actorId", "agentId", "createdAt", "canonicalBaseline", "projectionBaseline", "intent", "scope", "readiness", "items", "mustNotInfer", "mustNotDo", "toolPolicy", "outputContract", "provenance"],
  "properties": {
    "packageId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "actorId": {"type": "string", "minLength": 1},
    "agentId": {"type": "string", "minLength": 1},
    "delegationId": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "canonicalBaseline": {"type": "string", "minLength": 1},
    "projectionBaseline": {"type": "string", "minLength": 1},
    "schemaVersion": {"type": "string"},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globalObjective", "taskObjective", "deliverables", "definitionOfDone"],
      "properties": {
        "globalObjective": {"type": "string", "minLength": 1},
        "taskObjective": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "items": {"type": "string"}},
        "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "definitionOfDone": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "scope": {"$ref": "common.schema.json#/$defs/Scope"},
    "readiness": {"type": "string", "enum": ["SUFFICIENT_CURRENT", "PARTIAL_WITH_WARNING", "INSUFFICIENT", "CONFLICTED", "DENIED"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "kind", "content", "authority", "classification", "reasonForInclusion", "evidenceRefs"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["FACT", "DECISION", "CONSTRAINT", "KNOWLEDGE", "CONFLICT", "RISK", "EXAMPLE", "GAP", "REFERENCE"]},
          "content": {"type": "string", "minLength": 1},
          "authority": {"$ref": "common.schema.json#/$defs/AuthorityType"},
          "classification": {"$ref": "common.schema.json#/$defs/Classification"},
          "validFrom": {"type": "string", "format": "date-time"},
          "validUntil": {"type": "string", "format": "date-time"},
          "reasonForInclusion": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "enum": ["SAFE", "SUSPICIOUS", "QUARANTINED", "MANUAL_REVIEW"]},
          "evidenceRefs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/EvidenceRef"}}
        }
      }
    },
    "mustNotInfer": {"type": "array", "items": {"type": "string"}},
    "mustNotDo": {"type": "array", "items": {"type": "string"}},
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTools", "forbiddenActions"],
      "properties": {
        "allowedTools": {"type": "array", "items": {"type": "string"}},
        "requiredApprovals": {"type": "array", "items": {"type": "string"}},
        "forbiddenActions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedArtifacts", "verificationCriteria", "evidenceRequired"],
      "properties": {
        "expectedArtifacts": {"type": "array", "items": {"type": "string"}},
        "verificationCriteria": {"type": "array", "items": {"type": "string"}},
        "evidenceRequired": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrievalPlanId", "sourceRefs", "policyDecisionIds"],
      "properties": {
        "retrievalPlanId": {"type": "string", "minLength": 1},
        "sourceRefs": {"type": "array", "items": {"type": "string"}},
        "policyDecisionIds": {"type": "array", "items": {"type": "string"}},
        "contentDigest": {"type": "string"}
      }
    }
  }
}
